#!/bin/bash

# Ensure the script is running on macOS
if [ "$(uname -s)" != "Darwin" ]; then
  echo "Error: This script is intended for macOS only." >&2
  exit 1
fi

SCRIPT_DIR=$(dirname "$0")

# Determine the local CPU architecture
ARCH=$(uname -m)

if [ "$ARCH" = "x86_64" ]; then
  BAZEL_BIN="bazel-patched-x64"
elif [ "$ARCH" = "arm64" ]; then
  BAZEL_BIN="bazel-patched-arm64"
else
  echo "Error: Unsupported macOS architecture: $ARCH" >&2
  exit 1
fi

# Use 'exec' to replace the current shell process with the bazel process
# located next to this script, passing all arguments ("$@").
exec "$SCRIPT_DIR/$BAZEL_BIN" "$@"
